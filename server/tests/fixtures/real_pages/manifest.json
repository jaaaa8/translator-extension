        {
          "fixture_block_id": "b07",
          "bbox": [634, 434, 23, 96],
          "reading_order": 6,
          "kind": "dialogue",
          "src_text": "なぜだ？",
          "required": true
        },
        {
          "fixture_block_id": "b08",
          "bbox": [940, 642, 125, 154],
          "reading_order": 7,
          "kind": "dialogue",
          "src_text": "広告も好評で市民からの支持率も上昇しとるんだろ？",
          "required": true
