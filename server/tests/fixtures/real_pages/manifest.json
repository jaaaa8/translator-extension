        {
          "fixture_block_id": "b08",
          "bbox": [594, 370, 56, 63],
          "reading_order": 7,
          "kind": "dialogue",
          "src_text": "流石の手腕だ",
          "required": true
        },
        {
          "fixture_block_id": "b09",
          "bbox": [1008, 663, 57, 52],
          "reading_order": 8,
          "kind": "dialogue",
          "src_text": "フフなに",
          "required": true
        },
        {
          "fixture_block_id": "b10",
          "bbox": [602, 653, 92, 111],
          "reading_order": 9,
          "kind": "dialogue",
          "src_text": "組織の為と思えばこそですよ",
          "required": true
        },
        {
          "fixture_block_id": "b11",
          "bbox": [378, 38, 114, 148],
          "reading_order": 10,
          "kind": "dialogue",
          "src_text": "しかしこの件でメタルナイトの信用は更に失墜したな",
          "required": true
        },
        {
          "fixture_block_id": "b12",
          "bbox": [32, 50, 54, 96],
          "reading_order": 11,
          "kind": "dialogue",
          "src_text": "あの口だけ番長め",
          "required": true
        },
        {
          "fixture_block_id": "b13",
          "bbox": [387, 257, 78, 95],
          "reading_order": 12,
          "kind": "dialogue",
          "src_text": "ガードロボットの故障",
          "required": true
        },
        {
          "fixture_block_id": "b14",
          "bbox": [255, 259, 101, 112],
          "reading_order": 13,
          "kind": "dialogue",
          "src_text": "奴に設計建築を任せたこのビルの脆弱さ",
          "required": true
        },
        {
          "fixture_block_id": "b15",
          "bbox": [130, 252, 97, 114],
          "reading_order": 14,
          "kind": "dialogue",
          "src_text": "ああよくも不落の要塞だなどと",
          "required": true
        },
        {
          "fixture_block_id": "b16",
          "bbox": [36, 259, 47, 131],
          "reading_order": 15,
          "kind": "dialogue",
          "src_text": "建設に何百億と費やしておいて",
          "required": true
        },
        {
          "fixture_block_id": "b17",
          "bbox": [460, 503, 48, 110],
          "reading_order": 16,
          "kind": "dialogue",
          "src_text": "今後はアテにできんだろう",
          "required": true
        },
        {
          "fixture_block_id": "b18",
          "bbox": [148, 504, 46, 103],
          "reading_order": 17,
          "kind": "dialogue",
          "src_text": "ハゲマントめ…",
          "required": true
        },
        {
          "fixture_block_id": "b19",
          "bbox": [456, 667, 59, 86],
          "reading_order": 18,
          "kind": "dialogue",
          "src_text": "タツマキにしたってそうだ",
          "required": true
        },
        {
          "fixture_block_id": "b20",
          "bbox": [179, 665, 173, 106],
          "reading_order": 19,
          "kind": "dialogue",
          "src_text": "今回はマッコイ氏の計らいで不問に付したが独善と独走がすぎる",
          "required": true
        },
        {
          "fixture_block_id": "b21",
          "bbox": [59, 666, 101, 125],
          "reading_order": 20,
          "kind": "dialogue",
          "src_text": "指導しようにも力がケタ違いで誰も手綱を握れぬ始末",
