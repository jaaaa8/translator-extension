        },
        {
          "fixture_block_id": "b13",
          "bbox": [34, 316, 57, 84],
          "reading_order": 12,
          "kind": "dialogue",
          "src_text": "恐れ入ります",
          "required": true
        },
        {
          "fixture_block_id": "b14",
          "bbox": [449, 524, 52, 117],
          "reading_order": 13,
          "kind": "dialogue",
          "src_text": "しかし油断はできません",
          "required": true
        },
        {
          "fixture_block_id": "b15",
          "bbox": [286, 545, 87, 98],
          "reading_order": 14,
          "kind": "dialogue",
          "src_text": "毎日の様に発生する凶悪怪人達",
          "required": true
        },
        {
          "fixture_block_id": "b16",
          "bbox": [148, 521, 76, 154],
          "reading_order": 15,
          "kind": "dialogue",
          "src_text": "タツマキなどの一部の上位ヒーローを除けば",
