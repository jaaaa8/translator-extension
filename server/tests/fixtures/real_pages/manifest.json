          "fixture_block_id": "b05",
          "bbox": [963, 362, 117, 145],
          "reading_order": 4,
          "kind": "dialogue",
          "src_text": "周辺被害を「タツマキによる鬼怪人集団の撃退」によるものと報道することで",
          "required": true
        },
        {
          "fixture_block_id": "b06",
          "bbox": [770, 353, 76, 147],
          "reading_order": 5,
          "kind": "dialogue",
          "src_text": "ここで暮らす富豪達からの信頼も回復できた",
          "required": true
        },
        {
          "fixture_block_id": "b07",
          "bbox": [689, 354, 46, 146],
          "reading_order": 6,
          "kind": "dialogue",
          "src_text": "マッコイ氏の指揮だそうですな",
          "required": true
