        {
          "fixture_block_id": "b09",
          "bbox": [611, 655, 50, 153],
          "reading_order": 8,
          "kind": "dialogue",
          "src_text": "それはそうなんですが",
          "required": true
        },
        {
          "fixture_block_id": "b10",
          "bbox": [461, 42, 32, 113],
          "reading_order": 9,
          "kind": "dialogue",
          "src_text": "実は――",
          "required": true
        },
        {
          "fixture_block_id": "b11",
          "bbox": [451, 243, 51, 119],
          "reading_order": 10,
          "kind": "dialogue",
          "src_text": "報道とＣＭを見たぞ",
          "required": true
        },
        {
          "fixture_block_id": "b12",
          "bbox": [320, 245, 72, 98],
          "reading_order": 11,
          "kind": "dialogue",
          "src_text": "景気がよさそうじゃないか",
