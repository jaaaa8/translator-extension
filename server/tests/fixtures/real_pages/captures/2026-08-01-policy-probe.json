        "b11": "Nhưng vụ này càng khiến uy tín của Metal Knight sụt giảm trầm trọng.",
        "b21": "Dù muốn uốn nắn nhưng sức mạnh quá chênh lệch nên chẳng ai kiểm soát nổi.",
        "b14": "Sự yếu kém của tòa nhà này do chính hắn thiết kế và xây dựng.",
        "b06": "Chúng ta cũng lấy lại được niềm tin từ những người giàu có sống ở đây.",
        "b15": "Đúng thế, vậy mà dám gọi là pháo đài bất khả xâm phạm cơ đấy.",
        "b10": "Tất cả cũng vì lợi ích của tổ chức thôi.",
        "b01": "Công tác tuyên truyền diễn ra suôn sẻ nhỉ.",
        "b13": "Robot bảo vệ bị hỏng.",
        "b04": "Nâng cao hình ảnh qua quảng cáo và...",
        "b07": "Nghe nói là do McCoy chỉ huy đấy.",
        "b16": "Đã bỏ ra cả chục tỷ để xây dựng mà...",
        "b17": "Từ giờ chắc không trông chờ gì được nữa",
        "b12": "Cái tên chỉ giỏi nói phét đó",
        "b19": "Tatsumaki cũng vậy thôi",
        "b18": "Tên áo choàng hói...",
        "b08": "Đúng là tài năng xuất chúng",
        "b09": "Hừ, gì chứ",
        "b02": "Đang tuyển anh hùng mới! Chi tiết xem tại trang chủ",
